# Server-only stable Flask endpoint. Never use the public Jobs domain here.
NEXT_INTERNAL_API_ORIGIN=http://127.0.0.1:5000
# Explicit global routing default; do not infer from sessions/users/geolocation.
NEXT_DEFAULT_COUNTRY=br
# Global SEO origin without a country prefix.
NEXT_GLOBAL_CANONICAL_ORIGIN=https://jobs.portalerp.com
