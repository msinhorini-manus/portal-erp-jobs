FLASK_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-a-different-32-character-secret
DATABASE_URL=sqlite:////absolute/path/to/database/app.db
CORS_ORIGINS=https://jobs.portalerp.com.br
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
ALLOW_ADMIN_SETUP=false
REGIONAL_ALLOW_DEVELOPMENT_FALLBACK=false

# Recuperação de senha: escolha EMAIL_PROVIDER=smtp ou EMAIL_PROVIDER=resend.
# Em produção, sem provedor completo, /forgot-password responde 503 e não cria token.
EMAIL_PROVIDER=
EMAIL_FROM=Portal ERP Jobs <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=

# Rate limiting em memória (IP + identificador submetido). Compatível com o
# Gunicorn atual de 1 worker; use storage compartilhado antes de escalar workers.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=900
AUTH_FORGOT_RATE_LIMIT=5
AUTH_FORGOT_RATE_WINDOW=3600
AUTH_RESET_RATE_LIMIT=10
AUTH_RESET_RATE_WINDOW=3600
